extends ../layout

block content
    //- Encabezado
    div(class="mb-8 flex flex-col justify-between gap-4 sm:flex-row sm:items-center")
        div
            h2(class="text-2xl font-bold tracking-tight text-slate-900")
                | Registro de visitas
            p(class="mt-2 text-sm text-slate-500")
                | Administra y consulta los ingresos del condominio.

        a(
            href="/entries/nuevo"
            class="inline-flex items-center justify-center gap-2 rounded-xl bg-primary px-5 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-primary-dark active:scale-95"
        )
            span(class="text-xl") +
            | Registrar ingreso

    //- Buscador y filtros
    div(class="mb-6 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm")
        div(class="mb-5")
            h3(class="text-base font-bold text-slate-900")
                | Buscar visitas
            p(class="mt-1 text-sm text-slate-500")
                | Filtra por datos del visitante o por las fechas de ingreso y salida.

        form(action="/entries" method="GET")
            div(class="mb-5")
                label(
                    for="q"
                    class="mb-2 block text-sm font-medium text-slate-700"
                ) Buscar por código, visitante, documento, placa o motivo

                input(
                    id="q"
                    type="search"
                    name="q"
                    value=pagination.search
                    placeholder="Escribe lo que deseas buscar..."
                    class="w-full rounded-xl border border-slate-300 px-4 py-3 text-sm text-slate-800 outline-none transition focus:border-primary focus:ring-2 focus:ring-primary-light"
                )

            div(class="grid grid-cols-1 gap-5 md:grid-cols-2")
                div
                    label(
                        for="fechaIngreso"
                        class="mb-2 block text-sm font-medium text-slate-700"
                    ) Fecha de ingreso

                    input(
                        id="fechaIngreso"
                        type="date"
                        name="fechaIngreso"
                        value=pagination.fechaIngreso
                        class="w-full rounded-xl border border-slate-300 px-4 py-3 text-sm text-slate-800 outline-none transition focus:border-primary focus:ring-2 focus:ring-primary-light"
                    )

                div
                    label(
                        for="fechaSalida"
                        class="mb-2 block text-sm font-medium text-slate-700"
                    ) Fecha de salida

                    input(
                        id="fechaSalida"
                        type="date"
                        name="fechaSalida"
                        value=pagination.fechaSalida
                        class="w-full rounded-xl border border-slate-300 px-4 py-3 text-sm text-slate-800 outline-none transition focus:border-primary focus:ring-2 focus:ring-primary-light"
                    )

            div(class="mt-5 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between")
                div
                    label(
                        for="limit"
                        class="mb-2 block text-sm font-medium text-slate-700"
                    ) Registros por página

                    select(
                        id="limit"
                        name="limit"
                        class="w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm text-slate-800 outline-none focus:border-primary focus:ring-2 focus:ring-primary-light sm:w-44"
                    )
                        option(value="10" selected=pagination.limit === 10) 10 registros
                        option(value="20" selected=pagination.limit === 20) 20 registros
                        option(value="50" selected=pagination.limit === 50) 50 registros

                input(type="hidden" name="page" value="1")

                div(class="flex flex-wrap gap-3")
                    button(
                        type="submit"
                        class="inline-flex items-center justify-center rounded-xl bg-primary px-5 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-primary-dark active:scale-95"
                    )
                        | Buscar

                    a(
                        href="/entries"
                        class="inline-flex items-center justify-center rounded-xl border border-slate-300 px-5 py-3 text-sm font-semibold text-slate-700 transition hover:bg-slate-50"
                    )
                        | Limpiar filtros

    //- Resumen del historial
    div(class="mb-4 flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between")
        div
            h3(class="text-base font-bold text-slate-900")
                | Historial de ingresos
            p(class="mt-1 text-sm text-slate-500")
                | Registros encontrados: #{pagination.total}

        if pagination.total > 0
            p(class="text-sm text-slate-500")
                | Página #{pagination.page} de #{pagination.totalPages}

    //- Tabla de registros
    div(class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm")
        div(class="overflow-x-auto")
            table(class="w-full min-w-[1250px] text-left text-sm")
                thead(class="bg-slate-50 text-xs uppercase tracking-wider text-slate-500")
                    tr
                        th(class="px-5 py-4 font-semibold") Código
                        th(class="px-5 py-4 font-semibold") Fecha ingreso
                        th(class="px-5 py-4 font-semibold") Fecha salida
                        th(class="px-5 py-4 font-semibold") Visita
                        th(class="px-5 py-4 font-semibold") Documento
                        th(class="px-5 py-4 font-semibold") Medio ingreso
                        th(class="px-5 py-4 font-semibold") Placa
                        th(class="px-5 py-4 font-semibold") Identificación
                        th(class="px-5 py-4 font-semibold") Motivo ingreso
                        th(class="px-5 py-4 font-semibold") Estado
                        th(class="px-5 py-4 font-semibold") Registrado por
                        th(class="px-5 py-4 font-semibold") Acciones

                tbody(class="divide-y divide-slate-100")
                    if entries.length
                        each entry in entries
                            tr(class="transition hover:bg-violet-50/50")
                                td(class="whitespace-nowrap px-5 py-4 font-semibold text-slate-700")
                                    = entry.id

                                td(class="whitespace-nowrap px-5 py-4 text-slate-600")
                                    = entry.fecha_hora_ingreso

                                td(class="whitespace-nowrap px-5 py-4 text-slate-600")
                                    if entry.fecha_hora_salida
                                        = entry.fecha_hora_salida
                                    else
                                        span(class="text-amber-600")
                                            | Pendiente

                                td(class="px-5 py-4")
                                    p(class="font-semibold text-slate-800")
                                        = `${entry.nombres_visita || '-'} ${entry.apellidos_visita || ''}`.trim()

                                td(class="whitespace-nowrap px-5 py-4 text-slate-600")
                                    if entry.tipo_documento
                                        span(class="mr-1 font-medium")
                                            = entry.tipo_documento
                                    = entry.numero_documento || '-'

                                td(class="whitespace-nowrap px-5 py-4")
                                    span(class="inline-flex rounded-lg bg-primary-light px-3 py-1 text-xs font-semibold capitalize text-primary-dark")
                                        = entry.medio_ingreso || '-'

                                td(class="whitespace-nowrap px-5 py-4 font-medium text-slate-700")
                                    = entry.placa_vehiculo || '-'

                                td(class="whitespace-nowrap px-5 py-4 text-slate-600")
                                    = entry.identificacion_estado || '-'

                                td(class="max-w-xs px-5 py-4 text-slate-600")
                                    = entry.motivo_ingreso || '-'

                                td(class="whitespace-nowrap px-5 py-4")
                                    if !entry.fecha_hora_salida
                                        span(class="inline-flex items-center gap-2 rounded-full bg-emerald-50 px-3 py-1 text-xs font-semibold text-emerald-700")
                                            span(class="h-2 w-2 rounded-full bg-emerald-500")
                                            | Dentro
                                    else
                                        span(class="inline-flex items-center gap-2 rounded-full bg-slate-100 px-3 py-1 text-xs font-semibold text-slate-600")
                                            span(class="h-2 w-2 rounded-full bg-slate-400")
                                            | Salida registrada

                                td(class="whitespace-nowrap px-5 py-4 text-slate-600")
                                    = entry.registrado_por || '-'

                                td(class="px-5 py-4")
                                    div(class="flex flex-wrap items-center gap-2")
                                        if currentUser.rol === 'VIGILANTE'
                                            //- Nuevo ingreso basado en esta visita
                                            button(
                                                type="button"
                                                data-entry-id=entry.entry_id || entry.id
                                                class="inline-flex items-center justify-center whitespace-nowrap rounded-lg bg-indigo-100 px-3 py-2 text-xs font-bold text-indigo-800 shadow-sm transition hover:bg-indigo-200 active:scale-95 js-nuevo-ingreso"
                                            )
                                                | Nuevo ingreso

                                            a(
                                                href=`/entries/${entry.entry_id || entry.id}/editar`
                                                class="inline-flex items-center justify-center rounded-lg bg-violet-100 px-3 py-2 text-xs font-bold text-violet-800 shadow-sm transition hover:bg-violet-200 active:scale-95"
                                            )
                                                | Editar

                                            if !entry.fecha_hora_salida
                                                form(
                                                    method="POST"
                                                    action=`/entries/${entry.entry_id || entry.id}/salida`
                                                    onsubmit="return confirm('¿Confirmas la salida de esta visita?')"
                                                )
                                                    button(
                                                        type="submit"
                                                        class="inline-flex items-center justify-center whitespace-nowrap rounded-lg bg-emerald-600 px-3 py-2 text-xs font-bold text-white shadow-sm transition hover:bg-emerald-700 active:scale-95"
                                                    )
                                                        | Registrar salida

                                            form(
                                                method="POST"
                                                action=`/entries/${entry.entry_id || entry.id}/eliminar`
                                                onsubmit="return confirm('¿Estás seguro de eliminar esta visita?')"
                                            )
                                                button(
                                                    type="submit"
                                                    class="inline-flex items-center justify-center rounded-lg bg-red-600 px-3 py-2 text-xs font-bold text-white shadow-sm transition hover:bg-red-700 active:scale-95"
                                                )
                                                    | Eliminar
                                        else
                                            span(class="inline-flex items-center rounded-lg bg-slate-100 px-3 py-2 text-xs font-semibold text-slate-500")
                                                | Solo consulta

                    else
                        tr
                            td(
                                colspan="12"
                                class="px-5 py-16 text-center"
                            )
                                div(class="mx-auto flex h-14 w-14 items-center justify-center rounded-2xl bg-primary-light text-primary-dark")
                                    svg(
                                        xmlns="http://www.w3.org/2000/svg"
                                        width="28"
                                        height="28"
                                        viewBox="0 0 24 24"
                                        fill="none"
                                        stroke="currentColor"
                                        stroke-width="1.7"
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                    )
                                        circle(cx="11" cy="11" r="8")
                                        path(d="m21 21-4.35-4.35")

                                h3(class="mt-4 text-base font-semibold text-slate-800")
                                    | No se encontraron registros

                                p(class="mt-2 text-sm text-slate-500")
                                    | Modifica los criterios de búsqueda o limpia los filtros.

    //- Paginación
    if pagination.totalPages > 1
        div(class="mt-6 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between")
            p(class="text-sm text-slate-500")
                | Mostrando página #{pagination.page} de #{pagination.totalPages}

            div(class="flex flex-wrap items-center gap-2")
                if pagination.page > 1
                    a(
                        href=`/entries?q=${encodeURIComponent(pagination.search || '')}&fechaIngreso=${encodeURIComponent(pagination.fechaIngreso || '')}&fechaSalida=${encodeURIComponent(pagination.fechaSalida || '')}&limit=${pagination.limit}&page=${pagination.page - 1}`
                        class="inline-flex items-center justify-center rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-700 transition hover:bg-slate-50"
                    )
                        | Anterior
                else
                    span(class="inline-flex cursor-not-allowed items-center justify-center rounded-lg border border-slate-200 bg-slate-100 px-4 py-2 text-sm font-semibold text-slate-400")
                        | Anterior

                span(class="inline-flex items-center justify-center rounded-lg bg-primary px-4 py-2 text-sm font-semibold text-white")
                    = pagination.page

                if pagination.page < pagination.totalPages
                    a(
                        href=`/entries?q=${encodeURIComponent(pagination.search || '')}&fechaIngreso=${encodeURIComponent(pagination.fechaIngreso || '')}&fechaSalida=${encodeURIComponent(pagination.fechaSalida || '')}&limit=${pagination.limit}&page=${pagination.page + 1}`
                        class="inline-flex items-center justify-center rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-700 transition hover:bg-slate-50"
                    )
                        | Siguiente
                else
                    span(class="inline-flex cursor-not-allowed items-center justify-center rounded-lg border border-slate-200 bg-slate-100 px-4 py-2 text-sm font-semibold text-slate-400")
                        | Siguiente

    //- Modal de nuevo ingreso
    div#modalNuevoIngreso(
        class="fixed inset-0 z-50 hidden items-center justify-center overflow-y-auto bg-slate-950/60 p-4 backdrop-blur-sm"
        role="dialog"
        aria-modal="true"
        aria-labelledby="tituloModalNuevoIngreso"
    )
        div(class="my-auto max-h-[90vh] w-full max-w-2xl overflow-y-auto rounded-2xl bg-white shadow-2xl")
            div(class="flex items-center justify-between border-b border-slate-200 px-6 py-5")
                div
                    h2#tituloModalNuevoIngreso(class="text-xl font-bold text-slate-900")
                        | Registrar nuevo ingreso
                    p(class="mt-1 text-sm text-slate-500")
                        | Revisa los datos y actualiza los del nuevo ingreso.

                button(
                    type="button"
                    class="rounded-lg p-2 text-slate-500 transition hover:bg-slate-100 hover:text-slate-900"
                    data-cerrar-modal
                    aria-label="Cerrar modal"
                )
                    | ✕

            form#formNuevoIngreso(class="space-y-5 p-6")
                p#nuevoIngresoEstado(
                    class="hidden rounded-xl border p-3 text-sm"
                    role="status"
                    aria-live="polite"
                )

                div(class="grid grid-cols-1 gap-4 sm:grid-cols-2")
                    div
                        label(for="nuevoNombres" class="mb-1 block text-sm font-medium text-slate-700")
                            | Nombres
                        input#nuevoNombres(
                            type="text"
                            readonly
                            class="w-full rounded-xl border border-slate-200 bg-slate-100 px-3 py-2.5 text-sm text-slate-600"
                        )

                    div
                        label(for="nuevoApellidos" class="mb-1 block text-sm font-medium text-slate-700")
                            | Apellidos
                        input#nuevoApellidos(
                            type="text"
                            readonly
                            class="w-full rounded-xl border border-slate-200 bg-slate-100 px-3 py-2.5 text-sm text-slate-600"
                        )

                    div
                        label(for="nuevoDocumento" class="mb-1 block text-sm font-medium text-slate-700")
                            | Documento
                        input#nuevoDocumento(
                            type="text"
                            readonly
                            class="w-full rounded-xl border border-slate-200 bg-slate-100 px-3 py-2.5 text-sm text-slate-600"
                        )

                    div
                        label(for="nuevoMedio" class="mb-1 block text-sm font-medium text-slate-700")
                            | Medio de ingreso
                        input#nuevoMedio(
                            type="text"
                            readonly
                            class="w-full rounded-xl border border-slate-200 bg-slate-100 px-3 py-2.5 text-sm text-slate-600"
                        )

                    div#grupoNuevaPlaca
                        label(for="nuevoPlaca" class="mb-1 block text-sm font-medium text-slate-700")
                            | Placa
                        input#nuevoPlaca(
                            name="placa_vehiculo"
                            type="text"
                            maxlength="15"
                            class="w-full rounded-xl border border-slate-300 px-3 py-2.5 text-sm uppercase outline-none focus:border-primary focus:ring-2 focus:ring-primary-light"
                        )

                    div#grupoNuevoColor
                        label(for="nuevoColor" class="mb-1 block text-sm font-medium text-slate-700")
                            | Color del vehículo
                        input#nuevoColor(
                            name="color_vehiculo"
                            type="text"
                            maxlength="50"
                            class="w-full rounded-xl border border-slate-300 px-3 py-2.5 text-sm outline-none focus:border-primary focus:ring-2 focus:ring-primary-light"
                        )

                    div#grupoNuevosPasajeros
                        label(for="nuevosPasajeros" class="mb-1 block text-sm font-medium text-slate-700")
                            | Cantidad de pasajeros
                        input#nuevosPasajeros(
                            name="cantidad_pasajeros"
                            type="number"
                            min="0"
                            step="1"
                            class="w-full rounded-xl border border-slate-300 px-3 py-2.5 text-sm outline-none focus:border-primary focus:ring-2 focus:ring-primary-light"
                        )

                    div(class="sm:col-span-2")
                        label(for="nuevoMotivo" class="mb-1 block text-sm font-medium text-slate-700")
                            | Motivo del ingreso
                        textarea#nuevoMotivo(
                            name="motivo_ingreso"
                            rows="3"
                            maxlength="1000"
                            class="w-full rounded-xl border border-slate-300 px-3 py-2.5 text-sm outline-none focus:border-primary focus:ring-2 focus:ring-primary-light"
                        )

                div(class="flex flex-col-reverse gap-3 border-t border-slate-200 pt-5 sm:flex-row sm:justify-end")
                    button(
                        type="button"
                        data-cerrar-modal
                        class="rounded-xl border border-slate-300 px-5 py-3 text-sm font-semibold text-slate-700 transition hover:bg-slate-50"
                    )
                        | Cancelar

                    button#btnGuardarNuevoIngreso(
                        type="submit"
                        class="rounded-xl bg-primary px-5 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-primary-dark disabled:cursor-not-allowed disabled:opacity-60"
                    )
                        | Registrar ingreso

    script.
        (() => {
            const modal = document.getElementById('modalNuevoIngreso');
            const form = document.getElementById('formNuevoIngreso');
            const estado = document.getElementById('nuevoIngresoEstado');
            const botonGuardar = document.getElementById('btnGuardarNuevoIngreso');

            let registroId = null;
            let cargando = false;
            let enviando = false;

            function mostrarEstado(mensaje, tipo = 'info') {
                const estilos = {
                    info: 'border-blue-200 bg-blue-50 text-blue-800',
                    error: 'border-red-200 bg-red-50 text-red-800',
                    success: 'border-emerald-200 bg-emerald-50 text-emerald-800'
                };

                estado.className = `rounded-xl border p-3 text-sm ${estilos[tipo]}`;
                estado.textContent = mensaje;
            }

            function limpiarEstado() {
                estado.textContent = '';
                estado.className = 'hidden rounded-xl border p-3 text-sm';
            }

            function cerrarModal() {
                if (cargando || enviando) return;

                modal.classList.add('hidden');
                modal.classList.remove('flex');
                registroId = null;
            }

            function campo(id) {
                return document.getElementById(id);
            }

            async function abrirModal(id) {
                if (cargando || enviando) return;

                registroId = id;
                cargando = true;
                form.reset();
                limpiarEstado();

                modal.classList.remove('hidden');
                modal.classList.add('flex');
                botonGuardar.disabled = true;
                mostrarEstado('Cargando los datos de la visita anterior...');

                try {
                    const respuesta = await fetch(
                        `/entries/${encodeURIComponent(id)}/nuevo-ingreso`,
                        {
                            headers: { Accept: 'application/json' }
                        }
                    );

                    const resultado = await respuesta.json();

                    if (!respuesta.ok || !resultado.success) {
                        throw new Error(resultado.message || 'No se pudieron cargar los datos.');
                    }

                    const data = resultado.data;

                    campo('nuevoNombres').value = data.nombres_visita || '';
                    campo('nuevoApellidos').value = data.apellidos_visita || '';
                    campo('nuevoDocumento').value = data.numero_documento || '';
                    campo('nuevoMedio').value = data.medio_ingreso || '';

                    campo('nuevoPlaca').value = data.placa_vehiculo || '';
                    campo('nuevoColor').value = data.color_vehiculo || '';
                    campo('nuevosPasajeros').value = data.cantidad_pasajeros ?? '';
                    campo('nuevoMotivo').value = data.motivo_ingreso || '';

                    const esVehiculo = data.medio_ingreso === 'VEHICULO';

                    campo('grupoNuevaPlaca').classList.toggle('hidden', !esVehiculo);
                    campo('grupoNuevoColor').classList.toggle('hidden', !esVehiculo);
                    campo('grupoNuevosPasajeros').classList.toggle('hidden', !esVehiculo);

                    mostrarEstado(
                        'Verifica la placa y el motivo antes de registrar el nuevo ingreso.',
                        'info'
                    );

                    botonGuardar.disabled = false;
                    campo(esVehiculo ? 'nuevoPlaca' : 'nuevoMotivo').focus();
                } catch (error) {
                    mostrarEstado(error.message || 'Error al cargar los datos.', 'error');
                } finally {
                    cargando = false;
                }
            }

            document.querySelectorAll('.js-nuevo-ingreso').forEach((boton) => {
                boton.addEventListener('click', () => {
                    abrirModal(boton.dataset.entryId);
                });
            });

            modal.querySelectorAll('[data-cerrar-modal]').forEach((boton) => {
                boton.addEventListener('click', cerrarModal);
            });

            modal.addEventListener('click', (event) => {
                if (event.target === modal) cerrarModal();
            });

            document.addEventListener('keydown', (event) => {
                if (
                    event.key === 'Escape' &&
                    !modal.classList.contains('hidden')
                ) {
                    cerrarModal();
                }
            });

            form.addEventListener('submit', async (event) => {
                event.preventDefault();

                if (!registroId || cargando || enviando) return;

                enviando = true;
                botonGuardar.disabled = true;
                botonGuardar.textContent = 'Registrando...';

                try {
                    const payload = {
                        placa_vehiculo: campo('nuevoPlaca').value,
                        color_vehiculo: campo('nuevoColor').value,
                        cantidad_pasajeros: campo('nuevosPasajeros').value,
                        motivo_ingreso: campo('nuevoMotivo').value
                    };

                    const respuesta = await fetch(
                        `/entries/${encodeURIComponent(registroId)}/nuevo-ingreso`,
                        {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json',
                                Accept: 'application/json'
                            },
                            body: JSON.stringify(payload)
                        }
                    );

                    const resultado = await respuesta.json();

                    if (!respuesta.ok || !resultado.success) {
                        throw new Error(resultado.message || 'No se pudo registrar el ingreso.');
                    }

                    window.location.reload();
                } catch (error) {
                    mostrarEstado(
                        error.message || 'Ocurrió un error al registrar el ingreso.',
                        'error'
                    );
                } finally {
                    enviando = false;
                    botonGuardar.disabled = false;
                    botonGuardar.textContent = 'Registrar ingreso';
                }
            });
        })();
